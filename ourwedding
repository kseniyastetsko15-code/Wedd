* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Nunito', sans-serif;
  background: #fdf8f0;
  color: #1e3a5f;
  line-height: 1.7;
}

h1, h2, h3 { font-family: 'Comic Neue', cursive; font-weight: 700; }

/* ===== HERO ===== */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem 1.5rem;
  position: relative;
  background: linear-gradient(180deg, #d6e6f7 0%, #a8c8e8 40%, #fdf8f0 100%);
  overflow: hidden;
}

.stars-bg {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(2px 2px at 10% 20%, #f5c842 50%, transparent 50%),
    radial-gradient(2px 2px at 85% 15%, #f5c842 50%, transparent 50%),
    radial-gradient(1.5px 1.5px at 30% 70%, #fff 50%, transparent 50%),
    radial-gradient(2px 2px at 70% 60%, #f5c842 50%, transparent 50%),
    radial-gradient(1.5px 1.5px at 50% 10%, #fff 50%, transparent 50%),
    radial-gradient(2px 2px at 15% 85%, #f5c842 50%, transparent 50%),
    radial-gradient(1.5px 1.5px at 90% 80%, #fff 50%, transparent 50%);
  pointer-events: none;
}

.photo-frame {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  border: 5px dashed #f5c842;
  padding: 6px;
  background: #fff;
  box-shadow: 0 8px 25px rgba(30,58,95,0.15);
  position: relative;
  z-index: 1;
  transform: rotate(-3deg);
  transition: transform 0.3s;
  margin-bottom: 1.5rem;
}
.photo-frame:hover { transform: rotate(0deg) scale(1.03); }

.photo-frame img {
  width: 100%; height: 100%;
  object-fit: cover;
  border-radius: 50%;
}

.hero-sub {
  font-size: 0.95rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #4a6a8a;
  margin-bottom: 0.3rem;
  position: relative; z-index: 1;
}

.hero h1 {
  font-size: clamp(2.8rem, 9vw, 5rem);
  color: #1e3a5f;
  line-height: 1.2;
  position: relative; z-index: 1;
}
.hero h1 .amp { color: #f28b82; }

.hero-date {
  font-size: 1.3rem;
  color: #4a6a8a;
  margin: 0.5rem 0 1.8rem;
  font-weight: 600;
  position: relative; z-index: 1;
}

.btn {
  display: inline-block;
  padding: 0.9rem 2.5rem;
  background: #1e3a5f;
  color: #fff;
  text-decoration: none;
  border: none;
  border-radius: 50px;
  font-family: 'Comic Neue', cursive;
  font-size: 1.1rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 0 #142840;
  transition: transform 0.15s, box-shadow 0.15s;
  position: relative; z-index: 1;
}
.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 0 #142840;
}
.btn:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 #142840;
}

/* ===== SECTIONS ===== */
.section {
  padding: 4rem 1.5rem;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.section-title {
  font-size: 1.8rem;
  color: #1e3a5f;
  margin-bottom: 2rem;
  display: inline-block;
  position: relative;
}
.section-title::after {
  content: '✦';
  position: absolute;
  right: -25px;
  top: -5px;
  color: #f5c842;
  font-size: 1.2rem;
}
.section-title::before {
  content: '✦';
  position: absolute;
  left: -25px;
  top: -5px;
  color: #f28b82;
  font-size: 1.2rem;
}

/* ===== COUNTDOWN ===== */
.countdown {
  display: flex;
  justify-content: center;
  gap: 1.2rem;
  flex-wrap: wrap;
}

.cd-item {
  background: #fff;
  border: 3px solid #a8c8e8;
  border-radius: 20px;
  padding: 1.2rem 1.5rem;
  min-width: 85px;
  box-shadow: 0 4px 0 #a8c8e8;
}

.cd-item span {
  font-family: 'Comic Neue', cursive;
  font-size: 2.5rem;
  font-weight: 700;
  color: #1e3a5f;
  display: block;
  line-height: 1.1;
}
.cd-item p {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #4a6a8a;
}

/* ===== DETAILS ===== */
.details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}

.detail-card {
  background: #fff;
  border-radius: 20px;
  padding: 1.8rem 1.5rem;
  box-shadow: 0 4px 0 #d6e6f7;
  border: 2px solid #d6e6f7;
  text-align: center;
}
.detail-card h3 {
  color: #f28b82;
  font-size: 1.3rem;
  margin-bottom: 0.8rem;
}
.detail-time {
  font-family: 'Comic Neue', cursive;
  font-size: 2rem;
  color: #1e3a5f;
  font-weight: 700;
}
.detail-place {
  font-size: 0.9rem;
  color: #6a8aaa;
  margin-top: 0.5rem;
  font-style: italic;
}

/* ===== CALENDAR ===== */
.calendar {
  display: inline-block;
  background: #fff;
  border-radius: 20px;
  padding: 1.5rem 1.8rem;
  box-shadow: 0 4px 0 #d6e6f7;
  border: 2px solid #d6e6f7;
  max-width: 340px;
  width: 100%;
}

.cal-header {
  text-align: center;
  margin-bottom: 1rem;
}
.cal-month {
  font-family: 'Comic Neue', cursive;
  font-size: 1.4rem;
  font-weight: 700;
  color: #1e3a5f;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
}

.cal-day-name {
  font-size: 0.75rem;
  font-weight: 700;
  color: #f28b82;
  padding: 4px 0;
}

.cal-day {
  padding: 8px 0;
  font-size: 0.95rem;
  border-radius: 50%;
